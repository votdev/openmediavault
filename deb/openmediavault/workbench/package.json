{
  "name": "openmediavault-workbench",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "upgrade": "npm run upgrade:minor",
    "upgrade:minor": "ncu --upgrade --target minor",
    "upgrade:patch": "ncu --upgrade --target patch",
    "start": "ng serve --port 4201",
    "build": "ng build",
    "build:prod": "ng build --configuration production --verbose",
    "test": "ng test --watch --no-cache",
    "test:ci": "ng test --no-cache --max-workers=4",
    "lint:html": "htmllint src/app/**/*.html && html-linter --config html-linter.config.json",
    "lint:tsc": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint:eslint": "ng lint",
    "lint:scss": "stylelint \"**/*.scss\"",
    "lint": "run-p -cl --aggregate-output lint:*",
    "fix:eslint": "npm run lint:eslint -- --fix",
    "fix:scss": "stylelint \"**/*.scss\" --fix",
    "fix": "run-s -cl fix:*",
    "i18n": "npm run i18n:extract",
    "i18n:extract": "transloco-keys-manager extract --sort --replace",
    "e2e": "start-test http://localhost:4201 'cypress open'",
    "e2e:ci": "start-test http://localhost:4201 'cypress run -b chrome --headless'",
    "clean": "rm -rf ./.angular/ ./dist/ ./node_modules/ ./out-tsc/"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@mdi/angular-material": "^7.2.96",
    "@openng/ngx-toastr": "^1.1.1",
    "@siemens/ngx-datatable": "^27.1.0",
    "@uiw/codemirror-theme-github": "^4.25.12",
    "chart.js": "^4.6.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "cronstrue": "^3.43.0",
    "dayjs": "^1.11.23",
    "lodash": "^4.18.1",
    "marked": "^18.2.1",
    "ngx-scrollbar": "^19.1.5",
    "nunjucks": "^3.2.4",
    "rxjs": "~7.8.2",
    "strip-ansi": "^7.2.0",
    "tslib": "^2.9.1",
    "validator": "^13.15.35",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-builders/jest": "^22.0.1",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@angular/language-service": "^22.3.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@jsverse/transloco-keys-manager": "^8.1.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/nunjucks": "^3.2.6",
    "@types/validator": "^13.15.10",
    "angular-eslint": "^22.8.0",
    "cypress": "~16.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsdoc": "^65.5.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "html-linter": "^1.1.1",
    "htmllint-cli": "^0.0.7",
    "jest": "^30.5.2",
    "jest-canvas-mock": "^2.5.8",
    "jest-environment-jsdom": "^30.5.2",
    "npm-check-updates": "^23.1.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.10.1",
    "start-server-and-test": "^3.0.13",
    "stylelint": "^18.0.0",
    "stylelint-config-standard-scss": "~18.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
