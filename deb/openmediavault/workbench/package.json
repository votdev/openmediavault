{
  "name": "openmediavault-workbench",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "upgrade": "npm run upgrade:minor",
    "upgrade:minor": "ncu --upgrade --target minor",
    "upgrade:patch": "ncu --upgrade --target patch",
    "start": "ng serve --port 4201",
    "build": "ng build",
    "build:prod": "ng build --configuration production --verbose",
    "test": "ng test --watch --no-cache",
    "test:ci": "ng test --no-cache --max-workers=4",
    "lint:html": "htmllint src/app/**/*.html && html-linter --config html-linter.config.json",
    "lint:tsc": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint:eslint": "ng lint",
    "lint:scss": "stylelint \"**/*.scss\"",
    "lint": "run-p -cl --aggregate-output lint:*",
    "fix:eslint": "npm run lint:eslint -- --fix",
    "fix:scss": "stylelint \"**/*.scss\" --fix",
    "fix": "run-s -cl fix:*",
    "i18n": "npm run i18n:extract",
    "i18n:extract": "transloco-keys-manager extract --sort --replace",
    "e2e": "start-test http://localhost:4201 'cypress open'",
    "e2e:ci": "start-test http://localhost:4201 'cypress run -b chrome --headless'",
    "clean": "rm -rf ./.angular/ ./dist/ ./node_modules/ ./out-tsc/"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@mdi/angular-material": "^7.2.96",
    "@openng/ngx-toastr": "^1.1.1",
    "@siemens/ngx-datatable": "21.6.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "cronstrue": "^2.61.0",
    "dayjs": "^1.11.23",
    "lodash": "^4.18.1",
    "marked": "^17.0.6",
    "ngx-scrollbar": "^19.1.5",
    "nunjucks": "^3.2.4",
    "rxjs": "~7.8.2",
    "strip-ansi": "^7.2.0",
    "tslib": "^2.8.1",
    "validator": "^13.15.35",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-builders/jest": "^21.0.4",
    "@angular-devkit/build-angular": "^21.2.27",
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/language-service": "^21.2.25",
    "@jsverse/transloco-keys-manager": "^8.1.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.26",
    "@types/node": "^16.18.126",
    "@types/nunjucks": "^3.2.6",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cypress": "~13.17.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "html-linter": "^1.1.1",
    "htmllint-cli": "^0.0.7",
    "jest": "^30.5.2",
    "jest-canvas-mock": "^2.5.8",
    "jest-environment-jsdom": "^30.5.2",
    "npm-check-updates": "^16.14.20",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "start-server-and-test": "^2.1.5",
    "stylelint": "^15.11.0",
    "stylelint-config-standard-scss": "~9.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
